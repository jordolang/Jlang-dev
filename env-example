# Copy to .env.local for local development, and set the same values in
# Vercel (Project Settings > Environment Variables) for production.

# Site
NEXT_PUBLIC_SITE_URL=https://jlang.dev

# Sanity CMS (projects, blog, products, reviews, portal)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Server-only Editor token. Never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=your_server_only_sanity_editor_token
# Optional Viewer token for draft previews; falls back to the write token.
SANITY_API_READ_TOKEN=
# Sanity webhooks (review-request, project-update) send: Authorization: Bearer <this value>
SANITY_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
REVIEW_EMAIL_FROM=JLang Development <reviews@jlang.dev>
REVIEW_NOTIFICATION_EMAIL=you@example.com
PURCHASE_EMAIL_FROM=JLang Development <orders@jlang.dev>
PORTAL_EMAIL_FROM=JLang Development <portal@jlang.dev>

# Contact form (EmailJS)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Digital products store (Stripe)
STRIPE_SECRET_KEY=sk_test_your_key
# Endpoint: /api/webhooks/stripe, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Signs download links. Generate with: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=

# Client portal magic-link sessions. Generate with: openssl rand -hex 32
# Falls back to SANITY_API_WRITE_TOKEN if unset; set its own value in production.
PORTAL_SESSION_SECRET=

# Studio AI drafting and social copy
ANTHROPIC_API_KEY=

# Hourly scheduled-post publishing (vercel.json cron). Vercel sends it as a Bearer token.
CRON_SECRET=

# Live performance metrics on /performance (optional; without it no live PageSpeed data is fetched)
GOOGLE_PAGESPEED_API_KEY=

# Review flow handoff
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=your_place_id
